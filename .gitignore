# Initial repository allowlist: this workspace also contains unrelated projects.
# Explicitly allow new application roots here when implementation begins.
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
!/docs/superpowers/plans/
!/docs/superpowers/notes/
!/docs/superpowers/reports/

# Project roots added for implementation (keep this list minimal and explicit).
!/tools/
/tools/*
!/tools/voice-check/
!/tools/home-check/
!/tools/unity-check/
!/tools/start-perception.ps1
!/tools/stop-perception.ps1
# dotnet build output from the unity-check harness.
/tools/unity-check/obj/
/tools/unity-check/bin/
# Recorded test audio stays local; the *.wav rule below also covers this.
/tools/voice-check/cases/audio/
/tools/voice-check/cases/noise-30min/
/tools/voice-check/cases/self-trigger/

!/apps/
/apps/*

# Voice service (Python) and the Unity house project.
!/apps/voice-service/
/apps/voice-service/*
!/apps/voice-service/src/
!/apps/voice-service/tests/
!/apps/voice-service/requirements.lock.txt
!/apps/voice-service/pyproject.toml
!/apps/voice-service/README.md
/apps/voice-service/.venv/

!/apps/home-service/
/apps/home-service/*
!/apps/home-service/src/
!/apps/home-service/tests/
!/apps/home-service/config/
!/apps/home-service/requirements.lock.txt
!/apps/home-service/pyproject.toml
!/apps/home-service/README.md
!/apps/vision-service/
!/apps/vision-service/*
!/apps/vision-service/src/
!/apps/vision-service/config/
!/apps/vision-service/pyproject.toml
!/apps/vision-service/README.md
!/apps/perception-console/
!/apps/perception-console/**
/apps/perception-console/web/node_modules/
/apps/perception-console/web/dist/
/apps/perception-console/web/*.tsbuildinfo
!/apps/device-simulator/
/apps/device-simulator/*
!/apps/device-simulator/src/
!/apps/device-simulator/tests/
!/apps/device-simulator/Dockerfile
!/apps/device-simulator/requirements.lock.txt
!/infra/
/infra/*
!/infra/home-assistant/
/infra/home-assistant/*
!/infra/home-assistant/compose.override.yaml
!/infra/home-assistant/mosquitto.conf
!/infra/home-assistant/.env.example
!/infra/home-assistant/reuse.override.yaml
!/tools/ha-check/
!/runtime/
/runtime/*
!/runtime/perception/
/runtime/perception/*
!/runtime/perception/.gitkeep
password_file
device-state.json
fault-control.json
*.sqlite3

# Unity house. The project itself is created by Unity Hub and is regenerated
# freely, so nothing under it is tracked; only our payload and README are.
!/apps/unity-house-payload/
/apps/unity-house-payload/*
!/apps/unity-house-payload/Assets/
!/apps/unity-house-payload/README.md

# The Unity project is generated by the editor. Its package manifest and
# ProjectSettings are owned by Unity and were previously hand-written by
# mistake, which produced unreliable files.
/apps/unity-house/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json

# Dependencies, Python state and model artifacts
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
models/
*.onnx
*.pt
*.pth
*.safetensors
*.gguf

# Local diagnostics, recordings and audio artifacts.
# All audio is local test data: never commit it. Un-ignore a specific file with
# an explicit `!` rule only if it is genuinely meant to be documentation.
*.log
*.wav
*.pcm
*.mp3
*.m4a
*.flac
recordings/
.superpowers/

# Acceptance result files are regenerated per run; only commit a real outcome
# deliberately (git add -f) once a phase gate has actually been evaluated.
docs/superpowers/reports/artifacts/asr-results.json
docs/superpowers/reports/artifacts/wake-results.json
docs/superpowers/reports/artifacts/tts-listening.json

# Unity generated content (do not ignore Assets, Packages, ProjectSettings or .meta)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.vs/
